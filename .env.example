# Copy this file to .env and adjust. .env is read by src/racingmania/utils/paths.py.
# No secrets belong here: GitHub and Hugging Face logins are handled by `gh auth login` and `hf auth login`.

# Folder for large outputs that are not tracked by git: checkpoints, TensorBoard logs, generated track pools.
# A Windows drive path such as D:/AI/racingmania is translated to /mnt/d/AI/racingmania when running in WSL.
RACINGMANIA_DATA_DIR=D:/AI/racingmania

# Hugging Face account and collection that trained models are published to.
HF_NAMESPACE=your-hf-username
HF_COLLECTION_TITLE=RacingMania RL

# GitHub repository (owner/name) that results are pushed to by scripts/08_publish.py.
GITHUB_REPO=your-github-username/reinforcement-learning-in-trackmania-like-racing-game
